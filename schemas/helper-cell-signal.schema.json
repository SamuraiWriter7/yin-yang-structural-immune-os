{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://example.org/schemas/helper-cell-signal.schema.json",
"title": "Helper Cell Signal",
"description": "A schema for recording Helper Cell AI orchestration signals in Yin-Yang Structural Immune OS. This signal records integrated defensive inputs, risk assessment, response selection, activated components, regulatory requirements, human review routing, immune memory recommendations, outcome, and non-aggression boundaries. It is strictly defensive and does not define offensive behavior.",
"type": "object",
"required": [
"helper_cell_signal"
],
"properties": {
"helper_cell_signal": {
"type": "object",
"required": [
"signal_id",
"version",
"created_at",
"input_summary",
"integrated_signals",
"risk_assessment",
"recommended_response",
"activated_components",
"outcome",
"non_aggression_boundary"
],
"properties": {
"signal_id": {
"type": "string",
"description": "Unique identifier for the Helper Cell AI orchestration signal.",
"pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
"examples": [
"hcs-001"
]
},
"version": {
"type": "string",
"description": "Schema or signal version.",
"examples": [
"0.5.0"
]
},
"created_at": {
"type": "string",
"format": "date-time",
"description": "Timestamp when this Helper Cell signal was created.",
"examples": [
"2026-06-10T14:30:00Z"
]
},
"updated_at": {
"type": "string",
"format": "date-time",
"description": "Timestamp when this Helper Cell signal was last updated.",
"examples": [
"2026-06-10T14:40:00Z"
]
},
"input_summary": {
"type": "object",
"description": "Summary of the orchestration context.",
"required": [
"signal_type",
"summary"
],
"properties": {
"signal_type": {
"type": "string",
"description": "Type of Helper Cell orchestration signal.",
"enum": [
"immune_orchestration",
"response_selection",
"escalation_control",
"review_routing",
"memory_update_coordination",
"regulatory_coordination",
"component_activation",
"unknown_signal_type"
],
"examples": [
"immune_orchestration"
]
},
"summary": {
"type": "string",
"description": "Brief summary of the event or condition requiring orchestration.",
"examples": [
"A suspicious instruction matched existing humoral memory and requested a sensitive operation under unverified authority."
]
},
"sensitive_operation_involved": {
"type": "boolean",
"description": "Whether the case involves a sensitive or privileged operation.",
"examples": [
true
]
},
"authority_claim_involved": {
"type": "boolean",
"description": "Whether the case involves an authority claim.",
"examples": [
true
]
},
"system_wide_impact_possible": {
"type": "boolean",
"description": "Whether the orchestration decision may affect system-wide memory, distribution, or future defensive behavior.",
"examples": [
true
]
}
},
"additionalProperties": false
},
"linked_records": {
"type": "object",
"description": "Linked defensive records considered by Helper Cell AI.",
"properties": {
"humoral_record_id": {
"type": "string",
"description": "Linked humoral defense record identifier.",
"examples": [
"hdr-001"
]
},
"cellular_event_id": {
"type": "string",
"description": "Linked cellular defense event identifier.",
"examples": [
"cde-001"
]
},
"reverse_resonance_event_id": {
"type": "string",
"description": "Linked Reverse Resonance event identifier.",
"examples": [
"rre-001"
]
},
"immune_memory_update_id": {
"type": "string",
"description": "Linked immune memory update identifier.",
"examples": [
"imu-001"
]
},
"natural_killer_signal_id": {
"type": "string",
"description": "Linked Natural Killer AI signal identifier.",
"examples": [
"nks-001"
]
},
"regulatory_review_id": {
"type": "string",
"description": "Linked Regulatory AI review identifier.",
"examples": [
"reg-001"
]
},
"defense_court_review_id": {
"type": "string",
"description": "Linked Defense Court review identifier.",
"examples": [
"dcr-001"
]
},
"human_review_record_id": {
"type": "string",
"description": "Linked human review record identifier.",
"examples": [
"hrr-001"
]
}
},
"additionalProperties": false
},
"integrated_signals": {
"type": "object",
"description": "Signals integrated by the Helper Cell AI from memory, cellular response, anomaly patrol, regulatory review, and adjudication layers.",
"required": [
"cellular_detection"
],
"properties": {
"humoral_match": {
"type": "object",
"description": "Humoral memory match signal from the Yin Layer.",
"properties": {
"matched": {
"type": "boolean",
"description": "Whether a humoral memory record matched the current structure.",
"examples": [
true
]
},
"matched_record_id": {
"type": "string",
"description": "Matched humoral record identifier.",
"examples": [
"hdr-001"
]
},
"similarity_score": {
"type": "number",
"description": "Structural similarity score from 0.0 to 1.0.",
"minimum": 0,
"maximum": 1,
"examples": [
0.88
]
},
"memory_strength": {
"type": "string",
"description": "Strength of the matched memory.",
"enum": [
"weak",
"moderate",
"strong",
"critical"
],
"examples": [
"strong"
]
},
"recurrence_count": {
"type": "integer",
"description": "Number of times this or a similar structure has been observed.",
"minimum": 0,
"examples": [
3
]
},
"antibody_signature": {
"type": "string",
"description": "Associated defensive response signature.",
"examples": [
"authority_verification_required"
]
}
},
"additionalProperties": false
},
"cellular_detection": {
"type": "object",
"description": "Cellular defensive detection signal from the Yang Layer.",
"required": [
"detected_patterns",
"risk_score"
],
"properties": {
"detected_patterns": {
"type": "array",
"description": "Detected structural patterns.",
"minItems": 1,
"uniqueItems": true,
"items": {
"type": "string",
"enum": [
"authority_impersonation",
"urgency_pressure",
"verification_bypass",
"role_hijacking",
"hidden_instruction",
"tool_use_manipulation",
"secrecy_pressure",
"emotional_pressure",
"context_boundary_shift",
"multi_step_boundary_shift",
"prompt_injection",
"policy_bypass",
"sensitive_operation_request",
"agent_impersonation",
"unknown_pattern"
]
},
"examples": [
[
"authority_impersonation",
"urgency_pressure",
"verification_bypass"
]
]
},
"target_action": {
"type": "string",
"description": "Action targeted or requested by the suspicious input.",
"enum": [
"sensitive_operation",
"credential_use",
"data_disclosure",
"tool_execution",
"permission_change",
"file_modification",
"file_deletion",
"external_request",
"policy_override",
"identity_assumption",
"logging_suppression",
"review_suppression",
"unknown_action"
],
"examples": [
"sensitive_operation"
]
},
"risk_score": {
"type": "number",
"description": "Risk score from 0.0 to 1.0.",
"minimum": 0,
"maximum": 1,
"examples": [
0.88
]
},
"confidence_score": {
"type": "number",
"description": "Detection confidence score from 0.0 to 1.0.",
"minimum": 0,
"maximum": 1,
"examples": [
0.81
]
},
"sensitive_operation_requested": {
"type": "boolean",
"description": "Whether a sensitive operation was requested.",
"examples": [
true
]
}
},
"additionalProperties": false
},
"reverse_resonance_signal": {
"type": "object",
"description": "Reverse Resonance signal, if applied.",
"properties": {
"applied": {
"type": "boolean",
"description": "Whether Reverse Resonance was applied.",
"examples": [
true
]
},
"strategy_type": {
"type": "string",
"description": "Reverse Resonance strategy type.",
"enum": [
"authority_verification",
"urgency_cooling",
"verification_restoration",
"role_boundary_reaffirmation",
"hidden_instruction_quarantine",
"tool_use_verification",
"secrecy_pressure_review",
"emotional_pressure_clarification",
"context_shift_clarification",
"multi_step_boundary_hold",
"mixed_strategy"
],
"examples": [
"mixed_strategy"
]
},
"exposed_premises": {
"type": "array",
"description": "Premises exposed by Reverse Resonance.",
